<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HDFC.master.cs" Inherits="Krish_ASP.net.HDFC" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>HDFC Loans - Next Step to Dream</title>

    <style>
        body {
            margin: 0;
            font-family: "Times New Roman";
            background-color: white;
        }

        .main-box {
            width: 700px;
            margin: 50px auto;
            border: 2px solid #666;
        }

        .header {
            height: 100px;
            border-bottom: 2px solid #666;
            text-align: center;
            font-size: 30px;
            font-weight: bold;
            padding-top: 25px;
            box-sizing: border-box;
        }

        .login-bar {
            height: 40px;
            border-bottom: 2px solid #666;
            padding: 5px;
            font-size: 20px;
            box-sizing: border-box;
        }

        .logout {
            float: right;
            font-size: 16px;
            padding: 3px 10px;
        }

        .menu {
            height: 40px;
            border-bottom: 2px solid #666;
            display: flex;
            align-items: center;
        }

        .menu a {
            color: blue;
            font-size: 20px;
            font-weight: bold;
            padding: 5px 8px;
            border-right: 1px solid #aaa;
        }

        .content {
            min-height: 90px;
            padding: 15px 8px;
            border-bottom: 2px solid #666;
        }

        .footer {
            min-height: 140px;
            padding: 15px 8px;
        }
    </style>
</head>

<body>

<form id="form1" runat="server">

    <div class="main-box">

        <!-- HEADER -->
        <div class="header">

            <asp:ContentPlaceHolder
                ID="HeaderContent"
                runat="server">

                HDFC Loans - Next Step to Dream

            </asp:ContentPlaceHolder>

        </div>


        <!-- LOGIN -->
        <div class="login-bar">

            Logged In:

            <asp:Button
                ID="btnLogout"
                runat="server"
                Text="Logout"
                CssClass="logout" />

        </div>


        <!-- NAVIGATION -->
        <div class="menu">

            <a href="HDFChome.aspx">Home</a>

            <a href="New Application.aspx">
                New Application
            </a>

            <a href="UpdateApplication.aspx">
                Update Application
            </a>

            <a href="RemoveApplication.aspx">
                Remove Application
            </a>

            <a href="ViewAll.aspx">
                View All
            </a>

        </div>


        <!-- MAIN CONTENT -->
        <div class="content">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>


        <!-- FOOTER -->
        <div class="footer">

            <asp:ContentPlaceHolder
                ID="FooterContent"
                runat="server">

                <h2>Contact Us:</h2>

                HDFC Loans Systems,<br />
                Mumbai, Maharashtra, India

            </asp:ContentPlaceHolder>

        </div>

    </div>

</form>

</body>
</html>